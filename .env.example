# DataSentinel Configuration
# Application runs completely locally with deterministic logic without external services.

# Optional AI Provider configuration (Default: disabled, 100% offline deterministic engine)
DATASENTINEL_AI_PROVIDER=none
# Options: "none", "openai", "anthropic"
# DATASENTINEL_AI_API_KEY=
# DATASENTINEL_AI_MODEL=gpt-4o-mini

# Optional Performance settings
DATASENTINEL_MAX_UPLOAD_MB=100
DATASENTINEL_SAMPLE_THRESHOLD_ROWS=100000
